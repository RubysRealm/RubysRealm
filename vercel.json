{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "fluid": true,
  "git": {
    "deploymentEnabled": {
      "social-bot-state": false
    }
  },
  "rewrites": [
    {
      "source": "/kalshi-live",
      "destination": "/kalshi-live/index.html"
    },
    {
      "source": "/kalshi-api/:path*",
      "destination": "https://chatgpt-kalshi-live.onrender.com/:path*"
    },
    {
      "source": "/social-bot",
      "destination": "/social-bot.html"
    }
  ],
  "crons": [
    {
      "path": "/api/auto-post",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "api/video.js": {
      "maxDuration": 300
    },
    "api/story-video.js": {
      "maxDuration": 300
    },
    "api/auto-post.js": {
      "maxDuration": 300
    },
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
