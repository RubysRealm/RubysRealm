{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "fluid": true,
  "crons": [
    {
      "path": "/api/auto-post",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "api/video.js": {
      "maxDuration": 300
    },
    "api/story-video.js": {
      "maxDuration": 300
    },
    "api/auto-post.js": {
      "maxDuration": 300
    },
    "api/run-now-2ccac8b07e4d2fb56586ae3f.js": {
      "maxDuration": 300
    },
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
